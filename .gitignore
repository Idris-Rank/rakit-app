# Environment and secrets
.env
.env.*
!.env.example

# Composer dependencies
/vendor/

# Rakit runtime data
/storage/cache/
/storage/logs/*
/storage/sessions/*
/storage/views/*
/storage/database/
/storage/*.sqlite
/storage/*.sqlite3

# Keep runtime directories in Git
!/storage/cache/.gitkeep
!/storage/logs/.gitkeep
!/storage/sessions/.gitkeep
!/storage/views/.gitkeep
!/storage/database/.gitkeep

# Generated framework/application files
/key.php
.phpunit.result.cache

# IDE/editor files
.idea/
.vscode/
*.sublime-workspace
*.sublime-project
.phpactor.json

# Operating-system files
.DS_Store
Thumbs.db
Desktop.ini

# Logs and temporary files
*.log
*.tmp
*.temp
*.swp
*.swo
*~

# Coverage and local tooling output
coverage/
.phpunit.cache/
.php-cs-fixer.cache

# Local development configuration
Homestead.yaml
Homestead.json
